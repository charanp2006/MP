# HF_ENDPOINT_URL: Hugging Face -> Inference Endpoints -> your endpoint -> Inference API. Use the full OpenAI-compatible chat-completions URL ending in /v1/chat/completions.
HF_ENDPOINT_URL=https://<endpoint-id>.<region>.endpoints.huggingface.cloud/v1/chat/completions

# HF_MODEL_ID: For a dedicated endpoint, use the endpoint name shown in Hugging Face Inference Endpoints. For model-router mode, use the model repository ID such as Qwen/Qwen3-8B.
HF_MODEL_ID=<dedicated-endpoint-name-or-model-repo-id>

# HF_TOKEN: Hugging Face -> Settings -> Access Tokens -> New token. Use minimum required read access, accept model license if gated, and never commit the filled value.
HF_TOKEN=<hf-token>

# HF_MODEL_REVISION: Hugging Face model repo -> Files and versions -> branch name or commit SHA. Leave blank for dedicated endpoints; use only for router/model-repo mode.
HF_MODEL_REVISION=

# OPENROUTER_ENDPOINT_URL: OpenRouter API base; the default OpenAI-compatible chat-completions URL is already correct. Optional backup path only.
OPENROUTER_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions

# OPENROUTER_API_KEY: OpenRouter -> Account -> Keys -> Create key. Optional backup only; leave blank for the HF-only smoke and never commit the filled value.
OPENROUTER_API_KEY=

# OPENROUTER_MODEL: OpenRouter -> Models -> copy the exact provider/model ID for the Qwen3 model you want. Optional backup only.
OPENROUTER_MODEL=

# OPENROUTER_MODEL_REVISION: Read by the adapter but currently unused in the model reference. Leave blank unless OpenRouter revision support is implemented later.
OPENROUTER_MODEL_REVISION=

# OPENROUTER_SITE_URL: Optional HTTP-Referer for OpenRouter requests. Use http://localhost for local smoke tests; no secret value required.
OPENROUTER_SITE_URL=http://localhost
