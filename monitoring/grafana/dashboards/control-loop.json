{
  "uid": "control-loop",
  "title": "Serverless Control Loop",
  "tags": ["serverless", "tft", "ppo", "prometheus"],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Workload",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "workload", "legendFormat": "actual"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 2,
      "title": "P95 Latency",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"refId": "A", "expr": "p95_latency_ms", "legendFormat": "p95"},
        {"refId": "B", "expr": "vector(250)", "legendFormat": "SLA"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },
    {
      "id": 3,
      "title": "Active Containers",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "targets": [{"refId": "A", "expr": "containers_active", "legendFormat": "containers"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 4,
      "title": "Energy",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "targets": [{"refId": "A", "expr": "energy_w", "legendFormat": "watts"}],
      "fieldConfig": {"defaults": {"unit": "watt"}, "overrides": []}
    },
    {
      "id": 5,
      "title": "Cold Starts",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "targets": [{"refId": "A", "expr": "cold_starts", "legendFormat": "cold starts"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "id": 6,
      "title": "SLA Violations",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"refId": "A", "expr": "rate(sla_violations_total[5m])", "legendFormat": "violation rate"}],
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []}
    },
    {
      "id": 7,
      "title": "Control Actions",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"refId": "A", "expr": "sum by (action) (rate(action_selected_total[5m]))", "legendFormat": "{{action}}"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 8,
      "title": "Exporter Availability",
      "type": "stat",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 24},
      "targets": [{"refId": "A", "expr": "up{job=\"control-loop\"}", "legendFormat": "up"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
